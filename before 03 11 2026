function inspectFullSchema() {
  const cfg    = getConfigSheet();
  const apiKey = cfg.getRange(CFG.API_KEY, 2).getValue().toString().trim();
  const shopId = cfg.getRange(CFG.SHOP_ID, 2).getValue().toString().trim();

  const url =
    `https://pos.pages.fm/api/v1/shops/${shopId}/orders` +
    `?api_key=${encodeURIComponent(apiKey)}&page=1&page_size=3`;

  const res  = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
  const json = JSON.parse(res.getContentText());
  const orders = json.data || [];

  function flattenKeys(obj, prefix) {
    prefix = prefix || '';
    const result = [];
    Object.keys(obj || {}).forEach(key => {
      const fullKey = prefix ? prefix + '.' + key : key;
      const val = obj[key];
      if (val !== null && typeof val === 'object' && !Array.isArray(val)) {
        result.push([fullKey, '[object]', '']);
        flattenKeys(val, fullKey).forEach(r => result.push(r));
      } else if (Array.isArray(val)) {
        result.push([fullKey, '[array len=' + val.length + ']', JSON.stringify(val).slice(0, 200)]);
        if (val.length > 0 && typeof val[0] === 'object') {
          flattenKeys(val[0], fullKey + '[0]').forEach(r => result.push(r));
        }
      } else {
        result.push([fullKey, typeof val, val === null ? 'NULL' : String(val).slice(0, 200)]);
      }
    });
    return result;
  }

  const schema = getOrCreateSheet('🔍 Schema');
  schema.clearContents();
  schema.appendRow(['Key Path', 'Type', 'Sample Value']);
  schema.getRange(1, 1, 1, 3).setFontWeight('bold').setBackground('#e8710a').setFontColor('#ffffff');

  if (orders.length > 0) {
    const rows = flattenKeys(orders[0]);
    schema.getRange(2, 1, rows.length, 3).setValues(rows);
    schema.setColumnWidth(1, 350);
    schema.setColumnWidth(2, 100);
    schema.setColumnWidth(3, 500);
    schema.setFrozenRows(1);
    SpreadsheetApp.getUi().alert(`✅ Tìm thấy ${rows.length} fields. Xem sheet 🔍 Schema.`);
  }
}

