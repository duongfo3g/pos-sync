// ─── MENU ACTIONS ─────────────────────────────────────────────
function manualSync()  { syncOrders(false); }
function setAuto5()    { setAutoSync(5);  }
function setAuto15()   { setAutoSync(15); }
function setAuto30()   { setAutoSync(30); }
function setAuto60()   { setAutoSync(60); }
