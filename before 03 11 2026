    getOrCreateSheet(LOG_SHEET).getSheetId();
  SpreadsheetApp.getUi().showModelessDialog(
    HtmlService.createHtmlOutput(
      `<script>window.open('${url}');google.script.host.close();</script>`
    ), 'Mở log...'
  );
