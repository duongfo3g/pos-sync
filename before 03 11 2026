// ─── HELPERS ──────────────────────────────────────────────────

// Tìm row cuối thực sự có data ở cột A
// Tránh bị lừa bởi ArrayFormula ở các cột khác (BT:BX...)
function getLastDataRow(sheet) {
  const colA = sheet.getRange('A:A').getValues();
  for (let i = colA.length - 1; i >= 1; i--) {
    if (colA[i][0] !== '') return i + 1; // i là 0-based index → row = i+1
  }
  return 1; // chỉ có header row
}

function getConfigSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let s = ss.getSheetByName(CONFIG_SHEET);
  if (!s) {
    s = ss.insertSheet(CONFIG_SHEET);
    s.getRange('A1:B6').setValues([
      ['Cấu hình',      ''],
      ['API Key',       ''],
      ['Shop ID',       ''],
      ['Last Sync',     ''],
      ['Auto Interval', 'Tắt'],
      ['Trạng thái',    '⏹ Chưa sync'],
    ]);
    s.getRange('A1:A6').setFontWeight('bold');
    s.setColumnWidth(1, 150);
    s.setColumnWidth(2, 300);
  }
  return s;
}

function getOrCreateSheet(name) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  return ss.getSheetByName(name) || ss.insertSheet(name);
}

function ensureOrdersHeader(sheet) {
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(ORDER_HEADERS);
    sheet.setFrozenRows(1);
  }
  sheet.getRange(1, 1, 1, ORDER_HEADERS.length)
    .setFontWeight('bold')
    .setBackground('#1a73e8')
    .setFontColor('#ffffff');
}

function clearDataFormatting(sheet) {
  const lastRow = getLastDataRow(sheet);
  if (lastRow < 2) return;
  const dataRange = sheet.getRange(2, 1, lastRow - 1, ORDER_HEADERS.length);
  dataRange.setBackground(null);
  dataRange.setFontColor(null);
  dataRange.setFontWeight('normal');
  dataRange.setFontStyle('normal');
}

function buildExistingIdMap(sheet) {
  const map = {};
  const lastRow = getLastDataRow(sheet);
  if (lastRow < 2) return map;
  const ids = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
  ids.forEach((r, i) => { if (r[0]) map[r[0]] = i + 2; });
  return map;
}

function normalizePhone(p) {
  p = p.toString().replace(/\D/g, '');
  if (p.startsWith('84')  && p.length === 11) p = '0' + p.slice(2);
  if (p.startsWith('855') && p.length >= 11)  p = '0' + p.slice(3);
  return "'" + p;
}

function toVNDate(iso) {
  if (!iso) return '';
  try {
    const d = new Date(iso + 'Z');
    return Utilities.formatDate(d, 'Asia/Ho_Chi_Minh', 'yyyy-MM-dd HH:mm:ss');
  } catch(e) { return iso; }
}

function formatVN(d) {
  return Utilities.formatDate(d, 'Asia/Ho_Chi_Minh', 'dd/MM/yyyy HH:mm:ss');
}

function writeLog(status, count, mode, err) {
  const s = getOrCreateSheet(LOG_SHEET);
  if (s.getLastRow() === 0) {
    s.appendRow(['Thời gian', 'Trạng thái', 'Số đơn', 'Mode', 'Lỗi']);
    s.getRange(1, 1, 1, 5).setFontWeight('bold').setBackground('#f0f0f0');
  }
  s.appendRow([formatVN(new Date()), status, count, mode, err]);
}

// ─── DỌN ĐƠN TRÙNG ────────────────────────────────────────────
// Chạy 1 lần để dọn sạch các order_id đã bị duplicate trong sheet
// (do bug ở các lần sync trước khi có LockService)
function dedupeOrdersSheet() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    SpreadsheetApp.getUi().alert('⏳ Đang có sync/dedupe khác chạy, thử lại sau ít giây.');
    return;
  }

  try {
    const sheet = getOrCreateSheet(ORDERS_SHEET);
    const lastRow = getLastDataRow(sheet);
    if (lastRow < 2) return;

    const range = sheet.getRange(2, 1, lastRow - 1, ORDER_HEADERS.length);
    const data  = range.getValues();

    const seen = {};
    const bsIdx = ORDER_HEADERS.length - 1;

    data.forEach(row => {
      const orderId = row[0];
      if (!orderId) return;
      if (!(orderId in seen)) {
        seen[orderId] = row;
      } else if (!seen[orderId][bsIdx] && row[bsIdx]) {
        seen[orderId] = row;
      }
    });

    const keepRows = Object.keys(seen).map(id => seen[id]);

    keepRows.sort((a, b) => {
      const av = a[1] instanceof Date ? a[1].getTime() : String(a[1] || '');
      const bv = b[1] instanceof Date ? b[1].getTime() : String(b[1] || '');
      return av < bv ? -1 : (av > bv ? 1 : 0);
    });

    const removedCount = data.length - keepRows.length;

    range.clearContent();
    if (keepRows.length > 0) {
      sheet.getRange(2, 1, keepRows.length, ORDER_HEADERS.length).setValues(keepRows);
    }

    SpreadsheetApp.getUi().alert(`✅ Đã xóa ${removedCount} dòng trùng. Còn lại ${keepRows.length} đơn.`);
    writeLog('DEDUPE', removedCount, 'Manual', `Removed ${removedCount} duplicate rows`);

  } finally {
    lock.releaseLock();
  }
}

