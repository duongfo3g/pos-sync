// ─── AUTO SYNC SETUP ──────────────────────────────────────────
function setAutoSync(minutes) {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === TRIGGER_FNAME) ScriptApp.deleteTrigger(t);
  });

  const cfg = getConfigSheet();
  if (minutes === 0) {
    cfg.getRange(CFG.AUTO_INTV, 2).setValue('Tắt');
    cfg.getRange(CFG.STATUS,    2).setValue('⏹ Tự động sync đã tắt');
    SpreadsheetApp.getUi().alert('Đã tắt tự động sync.');
    return;
  }

  ScriptApp.newTrigger(TRIGGER_FNAME).timeBased().everyMinutes(minutes).create();
  cfg.getRange(CFG.AUTO_INTV, 2).setValue(minutes + ' phút');
  cfg.getRange(CFG.STATUS,    2).setValue(`✅ Tự động sync mỗi ${minutes} phút`);
  SpreadsheetApp.getUi().alert(`✅ Đã bật tự động sync mỗi ${minutes} phút.`);
}

function autoSyncOrders() { syncOrders(true); }

// ─── CORE SYNC ────────────────────────────────────────────────
function syncOrders(isAuto) {
  // ★ Chặn 2 lần sync chạy chồng nhau (nguyên nhân chính gây trùng đơn)
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    writeLog('SKIPPED', 0, isAuto ? 'Auto' : 'Manual', 'Lock busy - đang có run khác');
    return;
  }

  try {
    const cfg      = getConfigSheet();
    const apiKey   = cfg.getRange(CFG.API_KEY,   2).getValue().toString().trim();
    const shopId   = cfg.getRange(CFG.SHOP_ID,   2).getValue().toString().trim();
    const lastSync = cfg.getRange(CFG.LAST_SYNC, 2).getValue();

    if (!apiKey || !shopId) {
      SpreadsheetApp.getUi().alert('⚠️ Chưa điền API Key hoặc Shop ID trong sheet ⚙️ Config.');
      return;
    }

    const now      = new Date();
    const fromDate = lastSync
      ? Utilities.formatDate(new Date(lastSync), 'UTC', "yyyy-MM-dd'T'HH:mm:ss")
      : '2024-01-01T00:00:00';

    cfg.getRange(CFG.STATUS, 2).setValue('🔄 Đang sync...');
    SpreadsheetApp.flush();

    const ordersSheet = getOrCreateSheet(ORDERS_SHEET);
    ensureOrdersHeader(ordersSheet);
    const existingIds = buildExistingIdMap(ordersSheet);  // order_id → sheet row number
    const seenInThisRun = new Set();                      // ★ chặn trùng ngay trong 1 lần fetch

    let page = 1, totalFetched = 0;
    const newRows = [];     // đơn hoàn toàn mới → append xuống dưới
    const updateRows = [];  // đơn đã có → ghi đè tại chỗ (row number, data)

    try {
      while (true) {
        const url =
          `https://pos.pages.fm/api/v1/shops/${shopId}/orders` +
          `?api_key=${encodeURIComponent(apiKey)}` +
          `&from_date=${fromDate}` +
          `&page=${page}&page_size=60`;

        const res  = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
        const json = JSON.parse(res.getContentText());

        if (!json.success) throw new Error(JSON.stringify(json));
        const batch = json.data || [];
        if (batch.length === 0) break;

        batch.forEach(o => {
          const row     = orderToRow(o);
          const orderId = row[0];
          if (existingIds[orderId] !== undefined) {
            // Đơn đã tồn tại: ghi đè nhưng GIỮ NGUYÊN appsheet_order_id ở cột BS
            updateRows.push({ sheetRow: existingIds[orderId], data: row });
          } else if (!seenInThisRun.has(orderId)) {   // ★ chỉ push nếu chưa gặp trong run này
            newRows.push(row);
            seenInThisRun.add(orderId);
          }
          totalFetched++;
        });

        if (batch.length < 60) break;
        page++;
        Utilities.sleep(300);
      }

      // ── 1. Ghi đè đơn đã tồn tại ─────────────────────────────
      // Chỉ ghi ORDER_HEADERS.length - 1 cột → bảo toàn appsheet_order_id (BS)
      updateRows.forEach(({ sheetRow, data }) => {
        ordersSheet.getRange(sheetRow, 1, 1, ORDER_HEADERS.length - 1)
          .setValues([data.slice(0, ORDER_HEADERS.length - 1)]);
      });

      // ── 2. Append đơn mới xuống cuối ─────────────────────────
      // Dùng getLastDataRow() scan cột A → không bị lừa bởi ArrayFormula cột BT:BX
      if (newRows.length > 0) {
        newRows.sort((a, b) => (a[1] || '').localeCompare(b[1] || ''));
        const lastRow = getLastDataRow(ordersSheet);
        ordersSheet.getRange(lastRow + 1, 1, newRows.length, ORDER_HEADERS.length)
          .setValues(newRows);
      }

      // ── 3. Xóa định dạng vùng data (giữ sạch, không highlight) ──
      clearDataFormatting(ordersSheet);

      const statusMsg = `✅ ${isAuto ? 'Auto' : 'Manual'} sync: ${totalFetched} đơn (${newRows.length} mới, ${updateRows.length} cập nhật) — ${formatVN(now)}`;
      cfg.getRange(CFG.LAST_SYNC, 2).setValue(Utilities.formatDate(now, 'UTC', "yyyy-MM-dd'T'HH:mm:ss"));
      cfg.getRange(CFG.STATUS,    2).setValue(statusMsg);
      writeLog('SUCCESS', totalFetched, isAuto ? 'Auto' : 'Manual', `+${newRows.length} mới / ${updateRows.length} updated`);
      if (!isAuto) SpreadsheetApp.getUi().alert(statusMsg);

    } catch (e) {
      const errMsg = '❌ Lỗi: ' + e.message;
      cfg.getRange(CFG.STATUS, 2).setValue(errMsg);
      writeLog('ERROR', 0, isAuto ? 'Auto' : 'Manual', e.message);
      if (!isAuto) SpreadsheetApp.getUi().alert(errMsg);
    }

  } finally {
    lock.releaseLock();   // ★ luôn nhả lock dù thành công hay lỗi
  }
}

// ─── GENERATE APPSHEET ORDER ID ───────────────────────────────
// Format: ORDER-ddMMyyyy-HHmmss-XXX
function generateOrderId(createdAt) {
  if (!createdAt) return '';
  const parts = createdAt.match(/(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2}):(\d{2})/);
  if (!parts) return '';
  const datePart = parts[3] + parts[2] + parts[1]; // ddMMyyyy
  const timePart = parts[4] + parts[5] + parts[6]; // HHmmss
  const uid      = Utilities.getUuid().replace(/-/g, '').substring(0, 3).toUpperCase();
  return 'ORDER-' + datePart + '-' + timePart + '-' + uid;
}

// ─── ORDER ROW MAPPER ─────────────────────────────────────────
function orderToRow(o) {
  const cust      = o.customer         || {};
  const shipAddr  = o.shipping_address || {};
  const partner   = o.partner          || {};
  const seller    = o.assigning_seller || {};
  const lastEd    = o.last_editor      || {};
  const page      = o.page             || {};
  const wh        = o.warehouse_info   || {};
  const items     = o.items            || [];
  const combos    = o.activated_combo_products || [];

  const itemsSummary = items.map(i => {
    const v = i.variation_info || {};
    return `${v.name || ''}(${v.product_display_id || ''}) x${i.quantity} @${v.retail_price || 0}`;
  }).join('; ');

  const itemsDetail = JSON.stringify(items.map(i => {
    const v = i.variation_info || {};
    return {
      sku           : v.product_display_id  || '',
      name          : v.name                || '',
      barcode       : v.barcode             || '',
      qty           : i.quantity            || 0,
      retail_price  : v.retail_price        || 0,
      total_discount: i.total_discount      || 0,
      is_bonus      : i.is_bonus_product    || false,
      note          : i.note               || '',
    };
  }));

  const combo         = combos[0] || {};
  const comboInfo     = combo.combo_product_info || {};
  const comboName     = comboInfo.name           || '';
  const comboDiscount = comboInfo.discount_amount || 0;

  const createdAtVN = toVNDate(o.inserted_at);

  return [
    o.id                                    || '',  // A  order_id
    createdAtVN,                                    // B  created_at
    toVNDate(o.updated_at),                         // C  updated_at
    o.bill_full_name                        || '',  // D  customer_name
    normalizePhone(o.bill_phone_number      || ''), // E  phone
    cust.customer_id                        || '',  // F  customer_id
    cust.fb_id                              || '',  // G  customer_fb_id
    cust.gender                             || '',  // H  customer_gender
    cust.order_count                        || 0,   // I  order_count
    cust.succeed_order_count                || 0,   // J  succeed_order_count
    cust.returned_order_count               || 0,   // K  returned_order_count
    cust.purchased_amount                   || 0,   // L  purchased_amount
    cust.conversation_link                  || '',  // M  conversation_link
    shipAddr.full_name                      || '',  // N  shipping_full_name
    normalizePhone(shipAddr.phone_number    || ''), // O  shipping_phone
    shipAddr.full_address || shipAddr.address || '',// P  shipping_address
    o.status_name || o.status               || '',  // Q  status
    o.sub_status                            || '',  // R  sub_status
    partner.partner_status                  || '',  // S  shipping_status
    partner.extend_code                     || '',  // T  shipping_code
    partner.partner_name                    || '',  // U  shipping_partner
    toVNDate(o.time_send_partner),                  // V  time_send_partner
    toVNDate(partner.picked_up_at),                 // W  picked_up_at
    toVNDate(partner.first_delivery_at),            // X  first_delivery_at
    toVNDate(o.estimate_delivery_date),             // Y  estimate_delivery
    o.tracking_link                         || '',  // Z  tracking_link
    o.order_currency                        || '',  // AA order_currency
    o.total_price                           || 0,   // AB total_price
    o.total_discount                        || 0,   // AC total_discount
    o.total_price_after_sub_discount        || 0,   // AD total_after_discount
    o.cod                                   || 0,   // AE cod
    o.money_to_collect                      || 0,   // AF money_to_collect
    o.shipping_fee                          || 0,   // AG shipping_fee
    o.partner_fee                           || 0,   // AH partner_fee
    o.tax                                   || 0,   // AI tax
    o.surcharge                             || 0,   // AJ surcharge
    o.cash                                  || 0,   // AK cash
    o.transfer_money                        || 0,   // AL transfer_money
    o.prepaid                               || 0,   // AM prepaid
    o.is_free_shipping                      || false, // AN is_free_shipping
    o.customer_pay_fee                      || false, // AO customer_pay_fee
    o.total_quantity                        || 0,   // AP total_qty
    itemsSummary,                                   // AQ items_summary
    itemsDetail,                                    // AR items_detail
    comboName,                                      // AS combo_name
    comboDiscount,                                  // AT combo_discount
    o.ads_source || o.order_sources_name    || '',  // AU ads_source
    o.order_sources_name                    || '',  // AV order_source
    o.ad_id                                 || '',  // AW ad_id
    o.post_id                               || '',  // AX post_id
    o.conversation_id                       || '',  // AY conversation_id
    o.page_id                               || '',  // AZ page_id
    page.name                               || '',  // BA page_name
    o.p_utm_source                          || '',  // BB p_utm_source
    o.p_utm_medium                          || '',  // BC p_utm_medium
    o.p_utm_campaign                        || '',  // BD p_utm_campaign
    o.p_utm_content                         || '',  // BE p_utm_content
    o.p_utm_term                            || '',  // BF p_utm_term
    seller.id                               || '',  // BG seller_id
